---
import { projects } from '../data/projects';
const { lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';
const copy = isPt ? {
  kicker: 'Desenvolvimento + TI · Cabo Verde', titleA: 'Sistemas que', titleB: 'fazem sentido.', lede: 'Sou Cláudio Tavares, estudante de Engenharia de Sistemas e Informática a construir produtos úteis, experiências offline e uma base sólida em sistemas.', cta: 'Ver projetos', contact: 'Falar comigo', cardTitle: 'Perfil em uma frase', cardText: 'A aprender em público, com curiosidade por produto, segurança e interfaces que respeitam as pessoas.', stats: [['05', 'projetos em destaque'], ['07', 'perfis no portal'], ['34', 'testes no Pong']], projects: 'Projetos selecionados', projectsIntro: 'Cinco trabalhos que mostram como penso: do telemóvel ao servidor, da regra de negócio à evidência.', all: 'Todos', journey: 'Percurso', journeyText: 'Formação em Engenharia de Sistemas e Informática, prática no Skodji Digital e transição consciente para desenvolvimento e TI.', learning: 'Aprendizagem contínua', learningText: 'Java e outras tecnologias aparecem como estudo em evolução. O emprego no Banco de Cabo Verde é parte do meu percurso profissional, não é apresentado como experiência de desenvolvimento.', contactTitle: 'Vamos conversar?', contactText: 'GitHub, LinkedIn ou uma conversa sobre um problema interessante.'
} : {
  kicker: 'Development + IT · Cabo Verde', titleA: 'Systems that', titleB: 'make sense.', lede: 'I am Cláudio Tavares, a Systems and Informatics Engineering student building useful products, offline experiences and a grounded systems practice.', cta: 'See projects', contact: 'Get in touch', cardTitle: 'Profile in one line', cardText: 'Learning in public, curious about product, security and interfaces that respect people.', stats: [['05', 'featured projects'], ['07', 'portal roles'], ['34', 'Pong tests']], projects: 'Selected projects', projectsIntro: 'Five pieces that show how I think: from phone to server, from business rule to evidence.', all: 'All', journey: 'Journey', journeyText: 'Systems and Informatics Engineering, Skodji Digital practice and a deliberate transition into development and IT.', learning: 'Still learning', learningText: 'Java and other technologies are presented as work in progress. My Banco de Cabo Verde job is part of my professional path, not claimed development experience.', contactTitle: 'Let’s talk', contactText: 'GitHub, LinkedIn or a conversation about an interesting problem.'
};
const categories = isPt ? ['Todos', 'Web', 'Mobile', 'Dados', 'Sistemas', 'Projeto académico'] : ['All', 'Web', 'Mobile', 'Data', 'Systems', 'Academic project'];
const categoryMap: Record<string, string> = { 'Dados': 'Data', 'Sistemas': 'Systems', 'Projeto académico': 'Academic project', 'Todos': 'All' };
---
<section class="hero" aria-labelledby="hero-title">
  <div><span class="kicker">{copy.kicker}</span><h1 id="hero-title">{copy.titleA}<br /><span>{copy.titleB}</span></h1><p class="lede">{copy.lede}</p><div class="hero-actions"><a class="button" href={isPt ? '#projetos' : '#projects'}>{copy.cta} ↓</a><a class="button secondary" href={isPt ? '#contacto' : '#contact'}>{copy.contact}</a></div></div>
  <aside class="hero-card"><div class="avatar">CT</div><h2>{copy.cardTitle}</h2><p>{copy.cardText}</p><div class="hero-meta">{copy.stats.map(([value,label]) => <div class="meta-box"><strong>{value}</strong>{label}</div>)}</div></aside>
</section>
<section class="section" id={isPt ? 'projetos' : 'projects'} aria-labelledby="projects-title"><div class="section-head"><div><span class="kicker">01 / {isPt ? 'Portefólio' : 'Portfolio'}</span><h2 id="projects-title">{copy.projects}</h2></div><p>{copy.projectsIntro}</p></div><div class="filters" role="group" aria-label={isPt ? 'Filtrar projetos' : 'Filter projects'}>{categories.map((category, index) => <button class:list={['filter', { active: index === 0 }]} data-filter={categoryMap[category] ?? category} type="button">{category}</button>)}</div><div class="projects-grid">{projects.map((project) => { const data = isPt ? project.pt : project.en; return <article class="project-card" data-category={project.category === 'Dados' ? 'Data' : project.category === 'Sistemas' ? 'Systems' : project.category === 'Projeto académico' ? 'Academic project' : project.category}><a href={`${isPt ? '' : '/en'}/projects/${project.slug}`}><img src={project.image} alt={project.title} loading="lazy" /><div class="project-card-body"><span class="kicker">{project.eyebrow}</span><h3>{project.title}</h3><p>{data.summary}</p><div class="tags">{project.tags.map((tag) => <span class="tag">{tag}</span>)}</div></div></a></article> })}</div></section>
<section class="section" id={isPt ? 'percurso' : 'journey'}><div class="section-head"><div><span class="kicker">02 / {isPt ? 'Contexto' : 'Context'}</span><h2>{copy.journey}</h2></div></div><div class="split"><article class="info-card"><h3>{isPt ? 'Percurso académico + prático' : 'Academic + practical path'}</h3><p>{copy.journeyText}</p><div class="skill-cloud"><span>Kotlin / Compose</span><span>PHP / MySQL</span><span>Python / Flask</span><span>JavaScript</span><span>Linux / Segurança</span><span>GitHub Pages</span></div></article><article class="info-card"><h3>{copy.learning}</h3><p>{copy.learningText}</p><p>{isPt ? 'Gosto de projetos que deixam uma prova clara: testes, documentação, uma demo jogável ou uma decisão bem explicada.' : 'I like projects that leave clear evidence: tests, documentation, a playable demo or a well-explained decision.'}</p></article></div></section>
<section class="section" id={isPt ? 'contacto' : 'contact'}><div class="contact"><div><span class="kicker">03 / {isPt ? 'Contacto' : 'Contact'}</span><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p></div><div class="hero-actions"><a class="button" href="https://www.linkedin.com/in/claudiojgtavares/">LinkedIn ↗</a><a class="button secondary" href="https://github.com/claudiojgtavares">GitHub ↗</a></div></div></section>
<script>
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.filter').forEach((item) => item.classList.remove('active')); button.classList.add('active'); const value = button.dataset.filter; document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => { card.hidden = value !== 'All' && card.dataset.category !== value; }); }));
</script>
