---
import { projects } from '../data/projects';
const { lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';
const projectCount = projects.length;
const projectCountWords = isPt ? ['zero', 'um', 'dois', 'três', 'quatro', 'cinco', 'seis', 'sete', 'oito', 'nove', 'dez'] : ['zero', 'one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine', 'ten'];
const projectCountWord = projectCountWords[projectCount] ?? String(projectCount);
const copy = isPt ? {
  eyebrow: 'Portefólio · Cabo Verde · 2026', titleA: 'Construo sistemas', titleB: 'que deixam sinais claros.',
  lede: 'Sou Cláudio Tavares, estudante de Engenharia de Sistemas e Informática a transformar problemas concretos em produtos úteis, experiências offline e uma prática consciente de TI.',
  primary: 'Explorar projetos', secondary: 'Conhecer o percurso', available: 'A aprender em público', location: 'Praia, Cabo Verde', profileTitle: 'Desenvolvimento + TI', profileText: 'Produto, segurança e sistemas com uma regra simples: deixar evidência para a próxima pessoa.',
  projectsLabel: '01 / Trabalho selecionado', projectsTitle: `${projectCountWord} projetos, uma forma de pensar.`, projectsIntro: 'Do telemóvel ao servidor: cada projeto mostra uma decisão, um limite e uma prova que pode ser consultada.', all: 'Todos', journeyLabel: '02 / Contexto', journeyTitle: 'Percurso que continua.', journeyIntro: 'Formação académica, prática deliberada e uma transição honesta para desenvolvimento e TI.', pathTitle: 'Académico + prático', pathText: 'Engenharia de Sistemas e Informática, prática no Skodji Digital e trabalho no Banco de Cabo Verde apresentado como percurso profissional — não como experiência de desenvolvimento.', learningTitle: 'Em evolução', learningText: 'Java e cloud aparecem como aprendizagem contínua. Gosto de projetos que deixam um rasto: testes, documentação, uma demo ou uma decisão bem explicada.', timelineTitle: 'Percurso Skodji Digital', timelineTodo: 'TODO — completar com a principal aprendizagem deste módulo.', contactLabel: '03 / Contacto', contactTitle: 'Vamos construir algo que faça sentido?', contactText: 'GitHub, LinkedIn ou uma conversa sobre um problema interessante.', contactCta: 'Falar comigo', github: 'Ver GitHub'
} : {
  eyebrow: 'Portfolio · Cabo Verde · 2026', titleA: 'I build systems', titleB: 'that leave clear signals.',
  lede: 'I am Cláudio Tavares, a Systems and Informatics Engineering student turning concrete problems into useful products, offline experiences and a thoughtful IT practice.',
  primary: 'Explore projects', secondary: 'See the journey', available: 'Learning in public', location: 'Praia, Cabo Verde', profileTitle: 'Development + IT', profileText: 'Product, security and systems with one simple rule: leave evidence for the next person.',
  projectsLabel: '01 / Selected work', projectsTitle: `${projectCountWord} projects, one way of thinking.`, projectsIntro: 'From phone to server: every project shows a decision, a boundary and evidence you can inspect.', all: 'All', journeyLabel: '02 / Context', journeyTitle: 'A path still in motion.', journeyIntro: 'Academic training, deliberate practice and an honest transition into development and IT.', pathTitle: 'Academic + practical', pathText: 'Systems and Informatics Engineering, Skodji Digital practice and a Banco de Cabo Verde job presented as professional context — not claimed development experience.', learningTitle: 'Still evolving', learningText: 'Java and cloud remain active learning areas. I like projects that leave a trail: tests, documentation, a demo or a well-explained decision.', timelineTitle: 'Skodji Digital path', timelineTodo: 'TODO — add the main learning outcome for this module.', contactLabel: '03 / Contact', contactTitle: 'Let’s build something that makes sense.', contactText: 'GitHub, LinkedIn or a conversation about an interesting problem.', contactCta: 'Get in touch', github: 'View GitHub'
};
const timelineModules = [
  { pt: 'Linux e Segurança na Cloud', en: 'Linux & Cloud Security' },
  { pt: 'BI e Cloud (Power BI)', en: 'BI & Cloud (Power BI)' },
  { pt: 'Engenharia de Inteligência Artificial', en: 'Artificial Intelligence Engineering' },
  { pt: 'Engenharia de Software e Python para Dados', en: 'Software Engineering & Python for Data' },
  { pt: 'Projeto e Demo Day', en: 'Project & Demo Day' }
];
const categories = isPt ? ['Todos', 'Web', 'Mobile', 'Dados', 'Sistemas', 'Projeto académico'] : ['All', 'Web', 'Mobile', 'Data', 'Systems', 'Academic project'];
const categoryMap: Record<string, string> = { 'Dados': 'Data', 'Sistemas': 'Systems', 'Projeto académico': 'Academic project', 'Todos': 'All' };
---
<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-intro reveal"><p class="eyebrow"><span class="eyebrow-mark"></span>{copy.eyebrow}</p><h1 id="hero-title">{copy.titleA}<br /><span>{copy.titleB}</span></h1><p class="hero-lede">{copy.lede}</p><div class="hero-actions"><a class="button button-primary" href={isPt ? '#projetos' : '#projects'}>{copy.primary}<span aria-hidden="true">↘</span></a><a class="button button-ghost" href={isPt ? '#percurso' : '#journey'}>{copy.secondary}<span aria-hidden="true">→</span></a></div><div class="hero-status"><span class="status-dot"></span><span>{copy.available}</span><span class="status-divider">·</span><span>{copy.location}</span></div></div>
  <aside class="profile-panel reveal" aria-label={copy.profileTitle}><div class="profile-panel-top"><span class="mono-label">profile / 01</span><span class="mono-label profile-live"><i></i> active</span></div><div class="profile-art"><div class="portrait-halo"></div><img src="/images/profile.webp" width="460" height="460" alt="Fotografia de perfil de Cláudio Tavares" /><span class="portrait-initials" aria-hidden="true">CT</span><span class="portrait-tag">CV · 15°N</span></div><div class="profile-copy"><h2>{copy.profileTitle}</h2><p>{copy.profileText}</p></div><div class="profile-meta"><div><strong>{String(projectCount).padStart(2, '0')}</strong><span>{isPt ? 'projetos em destaque' : 'featured projects'}</span></div><div><strong>34</strong><span>{isPt ? 'testes no Pong' : 'Pong tests'}</span></div><div><strong>∞</strong><span>{isPt ? 'curiosidade' : 'curiosity'}</span></div></div></aside>
</section>

<section class="signal-rail" aria-label={isPt ? 'Resumo profissional' : 'Professional summary'}><div><span>stack</span><strong>Kotlin · PHP · Python · JS</strong></div><div><span>focus</span><strong>Product · Systems · Security</strong></div><div><span>proof</span><strong>Tests · Docs · Demos</strong></div></section>

<section class="section projects-section" id={isPt ? 'projetos' : 'projects'} aria-labelledby="projects-title">
  <div class="section-heading reveal"><div><p class="eyebrow">{copy.projectsLabel}</p><h2 id="projects-title">{copy.projectsTitle}</h2></div><p>{copy.projectsIntro}</p></div>
  <div class="filters" role="group" aria-label={isPt ? 'Filtrar projetos' : 'Filter projects'}>{categories.map((category, index) => <button class:list={['filter', { active: index === 0 }]} data-filter={categoryMap[category] ?? category} type="button" aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</div>
  <div class="projects-grid">{projects.map((project, index) => {
    const data = isPt ? project.pt : project.en;
    const eyebrow = isPt ? project.eyebrow.pt : project.eyebrow.en;
    const tags = isPt ? project.tags.pt : project.tags.en;
    return <article class:list={['project-card', { featured: index === 0 }]} data-categories={project.filters.join('|')}><a href={`${isPt ? '' : '/en'}/projects/${project.slug}`} class="project-link">
      <div class:list={['project-visual', `media-${project.media ?? 'cover'}`]}>
        {project.gallery
          ? project.gallery.map((item) => <img class="project-gallery-image" src={item.src} alt={isPt ? item.alt.pt : item.alt.en} loading="lazy" decoding="async" fetchpriority="low" />)
          : <img src={project.image} alt={isPt ? (project.imageAlt?.pt ?? `Imagem do projeto ${project.title}`) : (project.imageAlt?.en ?? `${project.title} project preview`)} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
        <span class="project-index">0{index + 1}</span><span class="project-open" aria-hidden="true">↗</span>
      </div>
      <div class="project-card-body"><div class="project-card-label"><span class="kicker">{eyebrow}</span><span class="project-line" style={`--project-accent:${project.accent}`}></span></div><h3>{project.title}</h3><p>{data.summary}</p><div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="project-read">{isPt ? 'Abrir projeto' : 'Open project'} <span aria-hidden="true">→</span></span></div>
    </a></article>;
  })}</div>
</section>

<section class="section journey-section" id={isPt ? 'percurso' : 'journey'} aria-labelledby="journey-title"><div class="section-heading reveal"><div><p class="eyebrow">{copy.journeyLabel}</p><h2 id="journey-title">{copy.journeyTitle}</h2></div><p>{copy.journeyIntro}</p></div><div class="journey-grid"><article class="journey-card journey-main reveal"><span class="journey-number">01</span><h3>{copy.pathTitle}</h3><p>{copy.pathText}</p><div class="skill-cloud"><span>Kotlin / Compose</span><span>PHP / MySQL</span><span>Python / Flask</span><span>JavaScript</span><span>Linux / Security</span><span>GitHub Pages</span></div></article><article class="journey-card reveal"><span class="journey-number">02</span><h3>{copy.learningTitle}</h3><p>{copy.learningText}</p><div class="evidence-list"><span><i></i>{isPt ? 'Validação local' : 'Local validation'}</span><span><i></i>{isPt ? 'Documentação clara' : 'Clear documentation'}</span><span><i></i>{isPt ? 'Limites comunicados' : 'Boundaries communicated'}</span></div></article></div><div class="journey-timeline"><div class="timeline-heading"><p class="eyebrow">{copy.timelineTitle}</p></div><ol class="timeline-list">{timelineModules.map((module, index) => <li class="timeline-item"><span class="journey-number">0{index + 1}</span><h3>{isPt ? module.pt : module.en}</h3><p>{copy.timelineTodo}</p></li>)}</ol></div></section>

<section class="section contact-section" id={isPt ? 'contacto' : 'contact'}><div class="contact-panel reveal"><div><p class="eyebrow">{copy.contactLabel}</p><h2>{copy.contactTitle}</h2><p>{copy.contactText}</p></div><div class="contact-actions"><a class="button button-primary" href="https://www.linkedin.com/in/claudiojgtavares/" rel="noreferrer">{copy.contactCta}<span aria-hidden="true">↗</span></a><a class="button button-ghost" href="https://github.com/claudiojgtavares" rel="noreferrer">{copy.github}<span aria-hidden="true">↗</span></a></div></div></section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll<HTMLButtonElement>('.filter').forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); }); button.classList.add('active'); button.setAttribute('aria-pressed', 'true'); const value = button.dataset.filter; document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => { const categories = card.dataset.categories?.split('|') ?? []; card.hidden = value !== 'All' && !categories.includes(value ?? ''); }); }));
  const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .12 }); revealItems.forEach((item) => observer.observe(item)); } else revealItems.forEach((item) => item.classList.add('is-visible'));
</script>
