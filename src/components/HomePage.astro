---
import { projects } from '../data/projects';
import { contactEmail } from '../data/site';
import { certificates } from '../data/certificates';
import fs from 'node:fs';
import path from 'node:path';
const { lang = 'pt' } = Astro.props;
const isPt = lang === 'pt';
const formEndpoint = (import.meta.env.PUBLIC_FORM_ENDPOINT ?? '').trim();
const cvCandidates = isPt ? ['Claudio-Tavares-CV-pt.pdf', 'Claudio-Tavares-CV.pdf'] : ['Claudio-Tavares-CV-en.pdf', 'Claudio-Tavares-CV.pdf'];
const cvFile = cvCandidates.find((file) => fs.existsSync(path.join(process.cwd(), 'public', 'cv', file)));
const cvHref = cvFile ? `/cv/${cvFile}` : undefined;
const copy = isPt ? {
  eyebrow: 'Portefólio · Cabo Verde · 2026', titleA: 'Construo sistemas', titleB: 'que deixam sinais claros.',
  lede: 'Sou Cláudio Tavares, estudante de Engenharia de Sistemas e Informática a transformar problemas concretos em produtos úteis, apps e sistemas que funcionam mesmo sem internet, e uma prática consciente de TI.',
  primary: 'Explorar projetos', secondary: 'Conhecer o percurso', available: 'A aprender em público', location: 'Praia, Cabo Verde', profileTitle: 'Desenvolvimento + TI', profileText: 'Produto, segurança e sistemas com uma regra simples: deixar evidência para a próxima pessoa.',
  projectsLabel: 'Trabalho selecionado', projectsTitle: 'Cinco projetos, uma forma de pensar.', projectsIntro: 'Do telemóvel ao servidor: cada projeto mostra uma decisão, um limite e uma prova que pode ser consultada.', all: 'Todos', aboutLabel: 'Perfil', aboutTitle: 'Sobre mim', aboutText: 'Sou agente de segurança no Banco de Cabo Verde desde 2018 e estudante do 3.º ano de Engenharia de Sistemas e Informática na Universidade Jean Piaget de Cabo Verde. Em segurança aprendi o valor de procedimentos claros, atenção ao detalhe e responsabilidade, e é essa forma de trabalhar que levo para o software. Através do Skodji Digital e de projetos próprios, estou a construir a minha transição para o desenvolvimento, com foco em Java e Spring Boot. Prefiro mostrar o que construí, com demo, testes e documentação, a prometer o que ainda não fiz.', journeyLabel: 'Contexto', journeyTitle: 'Percurso que continua.', journeyIntro: 'Formação académica, prática deliberada e uma transição honesta para desenvolvimento e TI.', pathTitle: 'Académico + prático', pathText: 'Estudo Engenharia de Sistemas e Informática e frequento o Skodji Digital, incluindo Engenharia de Inteligência Artificial. Trabalho no Banco de Cabo Verde desde 2018, na área de segurança, e foi aí que ganhei disciplina com procedimentos, atenção ao detalhe e responsabilidade. Agora aplico isso a projetos de software.', learningTitle: 'Em evolução', learningText: 'Estou a aprender Java e Spring Boot, cloud e IA aplicada. Gosto de projetos que deixam rasto: testes, documentação, uma demo ou uma decisão bem explicada.', downloadCv: 'Baixar CV', certificatesLabel: 'Certificados', certificatesTitle: 'Certificados', contactLabel: 'Contacto', contactTitle: 'Vamos construir algo que faça sentido?', contactText: 'Tens um projeto, oportunidade ou colaboração em mente? Envia-me uma mensagem.', contactEmailLabel: 'Email', contactGithub: 'GitHub', contactLinkedin: 'LinkedIn', contactFormTitle: 'Envia uma mensagem', contactName: 'Nome', contactEmail: 'Email', contactMessage: 'Mensagem', contactNamePlaceholder: 'O teu nome', contactEmailPlaceholder: 'o.teu@email.com', contactMessagePlaceholder: 'Como posso ajudar?', contactSubmit: 'Enviar por email', contactSending: 'A enviar…', contactSuccess: 'Mensagem enviada. Obrigado pelo contacto.', contactError: 'Não foi possível enviar agora. Tenta novamente ou usa o email direto.', contactValidation: 'Preenche o nome, um email válido e a mensagem.', github: 'Ver GitHub'
} : {
  eyebrow: 'Portfolio · Cabo Verde · 2026', titleA: 'I build systems', titleB: 'that leave clear signals.',
  lede: 'I am Cláudio Tavares, a Systems and Informatics Engineering student turning concrete problems into useful products, apps and systems that work even without internet, and a thoughtful IT practice.',
  primary: 'Explore projects', secondary: 'See the journey', available: 'Learning in public', location: 'Praia, Cabo Verde', profileTitle: 'Development + IT', profileText: 'Product, security and systems with one simple rule: leave evidence for the next person.',
  projectsLabel: 'Selected work', projectsTitle: 'Five projects, one way of thinking.', projectsIntro: 'From phone to server: every project shows a decision, a boundary and evidence you can inspect.', all: 'All', aboutLabel: 'Profile', aboutTitle: 'About me', aboutText: 'I have worked as a security officer at Banco de Cabo Verde since 2018, and I am a 3rd-year Systems and Information Engineering student at Universidade Jean Piaget de Cabo Verde. Working in security taught me the value of clear procedures, attention to detail and responsibility, and that is the way of working I bring to software. Through Skodji Digital and my own projects, I am building my transition into development, with a focus on Java and Spring Boot. I prefer to show what I have built, with a demo, tests and documentation, rather than promise what I have not done yet.', journeyLabel: 'Context', journeyTitle: 'A path still in motion.', journeyIntro: 'Academic training, deliberate practice and an honest transition into development and IT.', pathTitle: 'Academic + practical', pathText: 'I study Systems and Information Engineering and attend Skodji Digital, including Artificial Intelligence Engineering. I have worked at Banco de Cabo Verde since 2018 in security, where I developed discipline around procedures, attention to detail and responsibility. I now apply that to software projects.', learningTitle: 'Still evolving', learningText: 'I am learning Java and Spring Boot, cloud and applied AI. I like projects that leave a trail: tests, documentation, a demo or a well-explained decision.', downloadCv: 'Download CV', certificatesLabel: 'Certificates', certificatesTitle: 'Certificates', contactLabel: 'Contact', contactTitle: 'Let’s build something that makes sense.', contactText: 'Have a project, opportunity or collaboration in mind? Send me a message.', contactEmailLabel: 'Email', contactGithub: 'GitHub', contactLinkedin: 'LinkedIn', contactFormTitle: 'Send a message', contactName: 'Name', contactEmail: 'Email', contactMessage: 'Message', contactNamePlaceholder: 'Your name', contactEmailPlaceholder: 'you@email.com', contactMessagePlaceholder: 'How can I help?', contactSubmit: 'Send by email', contactSending: 'Sending…', contactSuccess: 'Message sent. Thank you for reaching out.', contactError: 'Could not send it now. Try again or use the direct email.', contactValidation: 'Enter your name, a valid email and a message.', github: 'View GitHub'
};
const categories = isPt ? ['Todos', 'Web', 'Mobile', 'Dados', 'Sistemas', 'Projeto académico'] : ['All', 'Web', 'Mobile', 'Data', 'Systems', 'Academic project'];
const categoryMap: Record<string, string> = { 'Dados': 'Data', 'Sistemas': 'Systems', 'Projeto académico': 'Academic project', 'Todos': 'All' };
---
<section class="home-hero" aria-labelledby="hero-title">
  <div class="hero-intro reveal"><p class="eyebrow"><span class="eyebrow-mark"></span>{copy.eyebrow}</p><h1 id="hero-title">{copy.titleA}<br /><span>{copy.titleB}</span></h1><p class="hero-lede">{copy.lede}</p><div class="hero-actions"><a class="button button-primary" href={isPt ? '#projetos' : '#projects'}>{copy.primary}<span aria-hidden="true">↘</span></a><a class="button button-ghost" href={isPt ? '#percurso' : '#journey'}>{copy.secondary}<span aria-hidden="true">→</span></a>{cvHref && <a class="button button-ghost" href={cvHref} download>{copy.downloadCv}<span aria-hidden="true">↓</span></a>}</div><div class="hero-status"><span class="status-dot"></span><span>{copy.available}</span><span class="status-divider">·</span><span>{copy.location}</span></div></div>
  <aside class="profile-panel reveal" aria-label={copy.profileTitle}><div class="profile-panel-top"><span class="mono-label">Profile</span><span class="mono-label profile-live"><i></i> active</span></div><div class="profile-art"><div class="portrait-halo"></div><img src="/images/profile.webp" width="460" height="460" alt="Fotografia de perfil de Cláudio Tavares" /><span class="portrait-initials" aria-hidden="true">CT</span></div><div class="profile-copy"><h2>{copy.profileTitle}</h2><p>{copy.profileText}</p></div><div class="profile-meta"><div><strong>05</strong><span>{isPt ? 'projetos em destaque' : 'featured projects'}</span></div><div><strong>{isPt ? '3º' : '3rd'}</strong><span>{isPt ? 'ano de Engenharia' : 'year of Engineering'}</span></div><div><strong>8</strong><span>{isPt ? 'anos em segurança (BCV)' : 'years in security (BCV)'}</span></div></div></aside>
</section>

<section class="signal-rail" aria-label={isPt ? 'Resumo profissional' : 'Professional summary'}><div><span>{isPt ? 'Tecnologias' : 'Stack'}</span><strong>Kotlin · PHP · Python · JS</strong><small class="signal-note">{isPt ? 'A aprender: Java e Spring Boot' : 'Learning: Java and Spring Boot'}</small></div><div><span>{isPt ? 'Foco' : 'Focus'}</span><strong>{isPt ? 'Produto · Sistemas · Segurança' : 'Product · Systems · Security'}</strong></div><div><span>{isPt ? 'Prova' : 'Proof'}</span><strong>{isPt ? 'Testes · Documentação · Demos' : 'Tests · Docs · Demos'}</strong></div></section>

<section class="section projects-section" id={isPt ? 'projetos' : 'projects'} aria-labelledby="projects-title">
  <div class="section-heading reveal"><div><p class="eyebrow">{copy.projectsLabel}</p><h2 id="projects-title">{copy.projectsTitle}</h2></div><p>{copy.projectsIntro}</p></div>
  <div class="filters" role="group" aria-label={isPt ? 'Filtrar projetos' : 'Filter projects'}>{categories.map((category, index) => <button class:list={['filter', { active: index === 0 }]} data-filter={categoryMap[category] ?? category} type="button" aria-pressed={index === 0 ? 'true' : 'false'}>{category}</button>)}</div>
  <div class="projects-grid">{projects.map((project, index) => {
    const data = isPt ? project.pt : project.en;
    const eyebrow = isPt ? project.eyebrow.pt : project.eyebrow.en;
    const tags = isPt ? project.tags.pt : project.tags.en;
    return <article class:list={['project-card', { featured: index === 0 }]} data-categories={project.filters.join('|')}><a href={`${isPt ? '' : '/en'}/projects/${project.slug}`} class="project-link">
      <div class:list={['project-visual', `media-${project.media ?? 'cover'}`]}>
        {project.gallery
          ? project.gallery.map((item) => <img class="project-gallery-image" src={item.src} alt={isPt ? item.alt.pt : item.alt.en} loading="lazy" decoding="async" fetchpriority="low" />)
          : <img src={project.image} alt={isPt ? (project.imageAlt?.pt ?? `Imagem do projeto ${project.title}`) : (project.imageAlt?.en ?? `${project.title} project preview`)} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
        <span class="project-open" aria-hidden="true">↗</span>
      </div>
      <div class="project-card-body"><div class="project-card-label"><span class="kicker">{eyebrow}</span><span class="project-line" style={`--project-accent:${project.accent}`}></span></div><h3>{project.title}</h3><p>{data.summary}</p><div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div><span class="project-read">{isPt ? 'Abrir projeto' : 'Open project'} <span aria-hidden="true">→</span></span></div>
    </a></article>;
  })}</div>
</section>

<section class="section about-section" id="sobre" aria-labelledby="about-title"><div class="section-heading reveal"><div><p class="eyebrow">{copy.aboutLabel}</p><h2 id="about-title">{copy.aboutTitle}</h2></div><p class="about-copy">{copy.aboutText}</p></div></section>

<section class="section journey-section" id={isPt ? 'percurso' : 'journey'} aria-labelledby="journey-title"><div class="section-heading reveal"><div><p class="eyebrow">{copy.journeyLabel}</p><h2 id="journey-title">{copy.journeyTitle}</h2></div><p>{copy.journeyIntro}</p></div><div class="journey-grid"><article class="journey-card journey-main reveal"><span class="journey-badge">{isPt ? 'Formação Skodji Digital' : 'Skodji Digital training'}</span><h3>{copy.pathTitle}</h3><p>{copy.pathText}</p><div class="skill-cloud"><span>Kotlin / Compose</span><span>PHP / MySQL</span><span>Python / Flask</span><span>JavaScript</span><span>Linux / Security</span><span>GitHub Pages</span><span>{isPt ? 'Engenharia de IA' : 'AI Engineering'}</span></div></article><article class="journey-card reveal"><h3>{copy.learningTitle}</h3><p>{copy.learningText}</p><div class="evidence-list"><span><i></i>{isPt ? 'Validação local' : 'Local validation'}</span><span><i></i>{isPt ? 'Documentação clara' : 'Clear documentation'}</span><span><i></i>{isPt ? 'Limites comunicados' : 'Boundaries communicated'}</span></div></article></div></section>
{certificates.length > 0 && <section class="section certificates-section" id={isPt ? 'certificados' : 'certificates'} aria-labelledby="certificates-title"><div class="section-heading reveal"><div><p class="eyebrow">{copy.certificatesLabel}</p><h2 id="certificates-title">{copy.certificatesTitle}</h2></div></div><div class="certificates-grid">{certificates.map((certificate) => <article class="certificate-card"><h3>{isPt ? certificate.title : (certificate.titleEn ?? certificate.title)}</h3><p>{isPt ? certificate.issuer : (certificate.issuerEn ?? certificate.issuer)} · {certificate.date}</p>{certificate.link && <a class="project-read" href={certificate.link} rel="noreferrer">{isPt ? 'Ver certificado' : 'View certificate'} <span aria-hidden="true">↗</span></a>}</article>)}</div></section>}

<section class="section contact-section" id={isPt ? 'contacto' : 'contact'} aria-labelledby="contact-title"><div class="contact-panel contact-panel-enhanced reveal"><div class="contact-intro"><p class="eyebrow">{copy.contactLabel}</p><h2 id="contact-title">{copy.contactTitle}</h2><p>{copy.contactText}</p><div class="contact-details"><div class="contact-email-row"><span class="contact-email-address">{contactEmail}</span><a class="contact-icon-link" href={`mailto:${contactEmail}`} aria-label={`${copy.contactEmail}: ${contactEmail}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18v13H3zM3 6l9 7 9-7" /></svg></a></div><div class="contact-socials"><a class="contact-social" href="https://github.com/claudiojgtavares" rel="noreferrer">{copy.contactGithub}<span aria-hidden="true">↗</span></a><a class="contact-social" href="https://www.linkedin.com/in/claudiojgtavares/" rel="noreferrer">{copy.contactLinkedin}<span aria-hidden="true">↗</span></a></div></div></div><form class="contact-form" data-contact-form data-mailto={contactEmail} data-endpoint={formEndpoint}><h3>{copy.contactFormTitle}</h3><label for="contact-name">{copy.contactName}</label><input id="contact-name" name="name" type="text" autocomplete="name" placeholder={copy.contactNamePlaceholder} required /><label for="contact-email">{copy.contactEmail}</label><input id="contact-email" name="email" type="email" autocomplete="email" placeholder={copy.contactEmailPlaceholder} required /><label for="contact-message">{copy.contactMessage}</label><textarea id="contact-message" name="message" rows="5" placeholder={copy.contactMessagePlaceholder} required></textarea><div class="honeypot" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div><p class="form-status" data-form-status role="status" aria-live="polite"></p><button class="button button-primary contact-submit" type="submit"><span data-submit-label>{copy.contactSubmit}</span><span aria-hidden="true">↗</span></button></form></div></section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.filter').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll<HTMLButtonElement>('.filter').forEach((item) => { item.classList.remove('active'); item.setAttribute('aria-pressed', 'false'); }); button.classList.add('active'); button.setAttribute('aria-pressed', 'true'); const value = button.dataset.filter; document.querySelectorAll<HTMLElement>('.project-card').forEach((card) => { const categories = card.dataset.categories?.split('|') ?? []; card.hidden = value !== 'All' && !categories.includes(value ?? ''); }); }));
  const revealItems = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) { const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); observer.unobserve(entry.target); } }), { threshold: .12 }); revealItems.forEach((item) => observer.observe(item)); } else revealItems.forEach((item) => item.classList.add('is-visible'));
  const contactForm = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const contactStatus = document.querySelector<HTMLElement>('[data-form-status]');
  const contactSubmit = contactForm?.querySelector<HTMLButtonElement>('.contact-submit');
  const submitLabel = contactForm?.querySelector<HTMLElement>('[data-submit-label]');
  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(contactForm);
    const language = document.documentElement.lang === 'en' ? 'en' : 'pt';
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();
    const emailField = contactForm.elements.namedItem('email') as HTMLInputElement | null;
    const endpoint = contactForm.dataset.endpoint?.trim();
    const setStatus = (text: string, state: 'error' | 'success' | '') => { if (contactStatus) { contactStatus.textContent = text; contactStatus.dataset.state = state; } };
    if (String(data.get('website') ?? '').trim()) return;
    if (!name || !message || !emailField?.checkValidity() || !email) { setStatus(language === 'en' ? copy.contactValidation : copy.contactValidation, 'error'); return; }
    if (!endpoint) {
      const recipient = contactForm.dataset.mailto ?? '';
      const subject = language === 'en' ? 'Portfolio contact' : 'Contacto através do portefólio';
      const body = [`${language === 'en' ? 'Name' : 'Nome'}: ${name}`, `Email: ${email}`, '', message].join('\n');
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      return;
    }
    if (contactSubmit) contactSubmit.disabled = true;
    if (submitLabel) submitLabel.textContent = language === 'en' ? copy.contactSending : copy.contactSending;
    setStatus('', '');
    try {
      const response = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error(`Form request failed with ${response.status}`);
      contactForm.reset();
      setStatus(language === 'en' ? copy.contactSuccess : copy.contactSuccess, 'success');
    } catch {
      setStatus(language === 'en' ? copy.contactError : copy.contactError, 'error');
    } finally {
      if (contactSubmit) contactSubmit.disabled = false;
      if (submitLabel) submitLabel.textContent = language === 'en' ? copy.contactSubmit : copy.contactSubmit;
    }
  });
</script>
