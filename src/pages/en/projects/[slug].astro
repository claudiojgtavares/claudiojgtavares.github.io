---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { projects } from '../../../data/projects';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const data = project.en;
---
<BaseLayout title={`${project.title} — Cláudio Tavares`} description={data.summary} lang="en" path={`/en/projects/${project.slug}`}>
  <section class="detail-hero"><a class="back-link" href="/en/#projects">← Back to projects</a><span class="kicker">{project.eyebrow.en}</span><h1>{project.title}</h1><p class="lede">{data.summary}</p><div class="hero-actions"><a class="button button-primary" href={project.repo}>Code on GitHub ↗</a>{project.demo && <a class="button button-ghost" href={project.demo}>Playable demo ↗</a>}</div></section>
  <section class="detail-grid"><div class:list={['detail-media', `media-${project.media ?? 'cover'}`]}>{project.gallery ? project.gallery.map((item) => <img class="detail-gallery-image" src={item.src} alt={item.alt.en} loading="lazy" decoding="async" />) : <a class="detail-image-link" href={project.fullImage ?? project.image} target="_blank" rel="noreferrer" aria-label={`Open full image of ${project.title}`}><img class="detail-image" src={project.fullImage ?? project.image} alt={project.imageAlt?.en ?? `${project.title} project preview`} /></a>}</div><div class="detail-copy"><article class="info-card"><h2>Problem</h2><p>{data.problem}</p></article><article class="info-card"><h2>Solution</h2><p>{data.solution}</p></article><article class="info-card"><h2>Validation</h2><p>{data.validation}</p></article><article class="info-card"><h2>Stack</h2><div class="stack-list">{data.stack.map((tech) => <span>{tech}</span>)}</div></article></div></section>
</BaseLayout>
