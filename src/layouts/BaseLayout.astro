---
import '../styles/global.css';
const { title = 'Cláudio Tavares — Desenvolvimento + TI', description = 'Portefólio bilingue de desenvolvimento, sistemas e TI.', lang = 'pt', path = '/' } = Astro.props;
const alternate = lang === 'pt' ? `/en${path === '/' ? '/' : path}` : path.replace(/^\/en/, '') || '/';
const isPt = lang === 'pt';
const ogImage = 'https://claudiojgtavares.github.io/images/og-card.png';
const ogImageAlt = 'Cláudio Tavares — Desenvolvimento + TI, Cabo Verde';
---
<!doctype html>
<html lang={isPt ? 'pt-CV' : 'en'} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B1220" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://claudiojgtavares.github.io${Astro.url.pathname}`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <link rel="canonical" href={`https://claudiojgtavares.github.io${Astro.url.pathname}`} />
    <link rel="alternate" hreflang={isPt ? 'en' : 'pt'} href={`https://claudiojgtavares.github.io${alternate}`} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'Person', name: 'Cláudio Tavares', url: 'https://claudiojgtavares.github.io', image: 'https://claudiojgtavares.github.io/images/profile.webp', sameAs: ['https://github.com/claudiojgtavares', 'https://www.linkedin.com/in/claudiojgtavares/'], knowsAbout: ['Kotlin', 'PHP', 'Python', 'JavaScript', 'Linux', 'Cloud'] })} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isPt ? 'Saltar para o conteúdo' : 'Skip to content'}</a>
    <header class="site-header">
      <a class="brand" href={isPt ? '/' : '/en/'} aria-label={isPt ? 'Cláudio Tavares, início' : 'Cláudio Tavares, home'}><span class="brand-mark">CT</span><span>Cláudio <em>Tavares</em></span></a>
      <nav class="primary-nav" aria-label={isPt ? 'Navegação principal' : 'Primary navigation'}>
        <a href={isPt ? '/#projetos' : '/en/#projects'}>{isPt ? 'Projetos' : 'Projects'}</a><a href={isPt ? '/#percurso' : '/en/#journey'}>{isPt ? 'Percurso' : 'Journey'}</a><a href={isPt ? '/#contacto' : '/en/#contact'}>{isPt ? 'Contacto' : 'Contact'}</a>
      </nav>
      <div class="header-actions"><a class="lang-switch" href={alternate} aria-label={isPt ? 'Ver versão inglesa' : 'View Portuguese version'}>{isPt ? 'EN' : 'PT'}</a><button class="theme-toggle" type="button" data-theme-toggle data-light-label={isPt ? 'Mudar para tema escuro' : 'Switch to dark theme'} data-dark-label={isPt ? 'Mudar para tema claro' : 'Switch to light theme'} aria-label={isPt ? 'Mudar para tema claro' : 'Switch to light theme'} aria-pressed="false"><svg class="theme-icon sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg><svg class="theme-icon moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.6 15.4A8.4 8.4 0 0 1 8.6 3.4 8.4 8.4 0 1 0 20.6 15.4Z"></path></svg></button><button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="primary-nav"><span class="sr-only">{isPt ? 'Abrir menu' : 'Open menu'}</span><span></span><span></span></button></div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer"><div><span class="brand-mark small-mark">CT</span><span>Cláudio Tavares</span></div><span>Cabo Verde · {isPt ? 'Sistemas no Atlântico' : 'Atlantic systems'}</span><span><a href="https://github.com/claudiojgtavares" rel="noreferrer">GitHub</a><span class="footer-dot">·</span><a href="https://www.linkedin.com/in/claudiojgtavares/" rel="noreferrer">LinkedIn</a></span></footer>
    <script is:inline>
      const root = document.documentElement;
      const themeButton = document.querySelector('[data-theme-toggle]');
      const menuButton = document.querySelector('[data-menu-toggle]');
      const nav = document.querySelector('.primary-nav');
      const stored = localStorage.getItem('theme');
      if (stored === 'light' || stored === 'dark') root.dataset.theme = stored;
      const updateTheme = () => { const light = root.dataset.theme === 'light'; const label = light ? themeButton?.dataset.lightLabel : themeButton?.dataset.darkLabel; themeButton?.setAttribute('aria-label', label ?? (light ? 'Switch to dark theme' : 'Switch to light theme')); themeButton?.setAttribute('aria-pressed', String(light)); };
      updateTheme();
      themeButton?.addEventListener('click', () => { root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light'; localStorage.setItem('theme', root.dataset.theme); updateTheme(); });
      menuButton?.addEventListener('click', () => { const open = menuButton.getAttribute('aria-expanded') === 'true'; menuButton.setAttribute('aria-expanded', String(!open)); nav?.setAttribute('data-open', String(!open)); });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menuButton?.setAttribute('aria-expanded', 'false'); nav?.setAttribute('data-open', 'false'); }));
    </script>
  </body>
</html>
